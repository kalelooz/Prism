      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="Prism.Windows.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
          <uap5:StartupTask TaskId="PrismStartup" Enabled="false" DisplayName="Prism for Codex" />
